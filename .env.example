# Copie para .env e preencha. Nunca commite o .env.
DATABASE_URL=postgresql://demanda:CHANGE_ME@localhost:5432/demanda
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
ANTHROPIC_API_KEY=
SENTRY_DSN=

# Processamento automatico (classifica mensagens novas e abre demandas). 0 ou ausente = desligado.
WORKER_INTERVAL_SECONDS=30

# Monitor da Evolution (estado da instancia + reconciliacao de mensagens). Os dois juntos ligam o monitor.
EVOLUTION_URL=https://evolution.exemplo.com
EVOLUTION_API_KEY=troque-pela-chave-da-evolution
HEALTH_INTERVAL_SECONDS=60

# Agente dos socios (avisos pelo WhatsApp). Precisa de EVOLUTION_URL/EVOLUTION_API_KEY e de uma
# instancia propria, com o numero da plataforma (nunca o numero do escritorio que e escutado).
# Sem AGENT_SEND=1 o agente so ensaia: grava os textos na caixa de saida e nao envia nada.
AGENT_INSTANCE=demanda-agente
AGENT_SEND=0
AGENT_APP_URL=https://demanda-api.kxryyk.easypanel.host
# Para o agente entender respostas ("1", "2", "parado", "agenda"): segredo do webhook da
# instancia do agente (cabecalho X-Webhook-Secret), no mesmo molde do webhook do escritorio.
AGENT_WEBHOOK_SECRET=troque-por-um-segredo-longo-e-aleatorio

# IA de caso: agrupa as mensagens por assunto, escreve titulo/resumo/proximo passo e atualiza
# compromissos. Liga sozinha quando ha WORKER_INTERVAL_SECONDS e uma chave de IA. CASE_LLM=off
# desliga (volta ao agrupamento por regras). Teto de chamadas por tenant por dia.
CASE_LLM=on
CASE_MODEL=anthropic/claude-haiku-5.5
CASE_DAILY_CAP=400

# Agente em linguagem natural: o socio escreve livremente ("o que a Ana tem pendente?",
# "cria uma tarefa para o Bruno: ..."). Liga sozinho quando o agente esta ligado e ha chave de IA.
# AGENT_NL=off desliga (so os comandos curtos). Teto de chamadas de IA por empresa por dia.
AGENT_NL=on
AGENT_NL_MODEL=anthropic/claude-haiku-5.5
AGENT_NL_DAILY_CAP=100
