# Copie para .env e preencha. Nunca commite o .env.
DATABASE_URL=postgresql://demanda:CHANGE_ME@localhost:5432/demanda
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
ANTHROPIC_API_KEY=
SENTRY_DSN=

# Processamento automatico (classifica mensagens novas e abre demandas). 0 ou ausente = desligado.
WORKER_INTERVAL_SECONDS=30

# Monitor da Evolution (estado da instancia + reconciliacao de mensagens). Os dois juntos ligam o monitor.
EVOLUTION_URL=https://evolution.exemplo.com
EVOLUTION_API_KEY=troque-pela-chave-da-evolution
HEALTH_INTERVAL_SECONDS=60

# Agente dos socios (avisos pelo WhatsApp). Precisa de EVOLUTION_URL/EVOLUTION_API_KEY e de uma
# instancia propria, com o numero da plataforma (nunca o numero do escritorio que e escutado).
# Sem AGENT_SEND=1 o agente so ensaia: grava os textos na caixa de saida e nao envia nada.
AGENT_INSTANCE=demanda-agente
AGENT_SEND=0
AGENT_APP_URL=https://demanda-api.kxryyk.easypanel.host
